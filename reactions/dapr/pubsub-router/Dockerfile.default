# ------------------------------------------
# Build stage
# ------------------------------------------

FROM python:3.13-slim-bookworm AS build

# Copy uv binary from distroless image
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_DEV=1 \
    UV_PYTHON_DOWNLOADS=0

WORKDIR /app/dapr/pubsub-router

# Install project dependencies only (cached layer)
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=dapr/pubsub-router/uv.lock,target=uv.lock \
    --mount=type=bind,source=dapr/pubsub-router/pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=sdk/python,target=/app/sdk/python \
    uv sync --frozen --no-install-project --package pubsub-router

COPY dapr/pubsub-router/uv.lock dapr/pubsub-router/pyproject.toml .
COPY dapr/pubsub-router/app/ .

COPY sdk/python /app/sdk/python

# Build wheel and install it into the virtual environment
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-editable --package pubsub-router

# ------------------------------------------
# Runtime stage
# ------------------------------------------

FROM python:3.13-slim-bookworm

WORKDIR /app

COPY --from=build /app/dapr/pubsub-router/.venv .venv
COPY --from=build /app/dapr/pubsub-router .

ENV PATH="/app/.venv/bin:$PATH"

ENTRYPOINT ["python", "main.py"]